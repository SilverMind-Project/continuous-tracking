name: "face-recognition-adaface-ir50"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [1, 3, 112, 112]
  }
]

output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [1, 512]
  }
]

instance_group [{ kind: KIND_GPU count: 1 }]
