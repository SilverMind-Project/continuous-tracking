# YOLO26L person detector — TensorRT plan (NVIDIA GPU) or ONNX fallback.
#
# Authoritative tensor names from Ultralytics export:
#   YOLO(str("yolo26l.pt")).export(format="engine", imgsz=640, batch=16, device=0)
#   Input "images": shape [batch, 3, 640, 640]
#   Output "output0": NMS-free prediction tensor, shape [batch, 300, 6]
#     300 = maximum detections per image (baked-in NMS)
#     6   = x1, y1, x2, y2 (letterbox pixel space), confidence, class_id
#
# YOLO26L uses a NMS-Free end-to-end architecture; post-processing NMS is not
# required. class_id 0 = person (COCO).
#
# For Intel Arc (OpenVINO): change platform to "openvino" and store
#   1/model.xml + 1/model.bin exported from the ONNX via mo.py.
#
# Model name "person-detector" matches this directory name (Triton convention).

name: "person-detector"
platform: "tensorrt_plan"
max_batch_size: 16

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [300, 6]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
