# YOLO26L person detector — ONNX Runtime backend (NVIDIA GPU).
#
# Model file: triton-models/person-detector/1/model.onnx
# Export:     python triton-models/scripts/export_yolo.py --weights yolo26l.pt
#
# Output tensor "output0" shape: [batch, 300, 6]
#   300 = maximum detections per image
#   6   = x1, y1, x2, y2 (letterbox pixel space), confidence, class_id
#
# YOLO26L uses a NMS-Free end-to-end architecture. Verify the ONNX output
# shape before deploying — see export_yolo.py for the verification command.
# ONNX Runtime auto-selects TensorrtExecutionProvider then CUDAExecutionProvider.
# On first load Triton builds and caches a TRT engine; subsequent loads use the cache.

name: "person-detector"
platform: "onnxruntime_onnx"
default_model_filename: "model.onnx"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [8, 3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [8, 300, 6]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
