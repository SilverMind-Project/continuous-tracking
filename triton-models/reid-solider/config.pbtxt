# SOLIDER-REID 768-dim body re-identification model — ONNX Runtime backend (NVIDIA GPU).
#
# Source: https://github.com/tinyvision/SOLIDER-REID (CVPR 2023)
# Backbone: Swin-Tiny with SOLIDER semantic controller; 768-dim L2-normalised output.
# Input: 384×128 person crops, ImageNet-normalised.
#
# Export command (run from this repo root):
#   uv run --with torch --with onnx --with yacs \
#       python triton-models/scripts/export_reid.py
#
# Requires the SOLIDER-REID repository cloned alongside continuous-tracking
# and the MSMT17-fine-tuned checkpoint at:
#   triton-models/reid-solider/solider_swin_tiny_msmt17.pth
#
# Verify after export:
#   python -c "import onnx; m=onnx.load('1/model.onnx'); \
#     print([i.name for i in m.graph.input], [o.name for o in m.graph.output])"
#
name: "reid-solider"
platform: "onnxruntime_onnx"
default_model_filename: "model.onnx"
max_batch_size: 16

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [3, 384, 128]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [768]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
