# SOLIDER-REID 768-dim body re-identification — ONNX Runtime with OpenVINO EP (Intel Arc GPU).
#
# Activated by: python triton-models/scripts/configure_gpu.py --vendor intel
#
# Model file: triton-models/reid-solider/1/model.onnx  (same file as NVIDIA)
# The ONNX model is vendor-neutral; only the execution provider changes.

name: "reid-solider"
platform: "onnxruntime_onnx"
max_batch_size: 16

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [3, 256, 128]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [768]
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator : [
      {
        name : "openvino"
        parameters { key: "device_type" value: "GPU" }
      }
    ]
  }
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
