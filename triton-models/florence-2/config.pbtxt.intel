# Florence-2-large scene description — Python backend (Intel Arc GPU).
#
# Activated by: python triton-models/scripts/configure_gpu.py --vendor intel
#
# Same model as config.pbtxt but the Python backend in model.py reads
# the execution_accelerators config and sets OpenVINOExecutionProvider
# for ONNX Runtime on Intel Arc GPUs.

name: "florence-2"
backend: "python"
max_batch_size: 1

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [1, 3, -1, -1]
  },
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [1, -1]
  }
]

output [
  {
    name: "output_ids"
    data_type: TYPE_INT64
    dims: [1, -1]
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator : [
      {
        name : "openvino"
        parameters { key: "device_type" value: "GPU" }
      }
    ]
  }
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
