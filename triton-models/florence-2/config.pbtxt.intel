# Florence-2-large scene description — Python backend (Intel Arc GPU).
#
# The Python model orchestrates native ONNX Runtime sub-models via BLS.
# GPU acceleration is handled by the sub-model configs (florence-2-vision,
# florence-2-embed, florence-2-encoder, florence-2-decoder).
# The Python model itself does not use ONNX Runtime directly.

name: "florence-2"
backend: "python"
max_batch_size: 0

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [1, 3, -1, -1]
  },
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [1, -1]
  }
]

output [
  {
    name: "output_ids"
    data_type: TYPE_INT64
    dims: [1, -1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
