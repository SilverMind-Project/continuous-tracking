<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Additional permissions scoped strictly to the opt-in dualMode flavor (Tier 2 UWB bursts + LAN MQTT). -->
    <uses-permission android:name="android.permission.UWB_RANGING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- The step detector that triggers UWB bursts needs ACTIVITY_RECOGNITION (runtime grant). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-feature
        android:name="android.hardware.uwb"
        android:required="false" />

    <application>
        <!-- ADB-only Tier 2 provisioning: android.permission.DUMP is held by the ADB shell and never by installed apps. -->
        <receiver
            android:name="io.silvermind.wearcompanion.app.uwb.Tier2ProvisioningReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.silvermind.wearcompanion.PROVISION_TIER2" />
                <action android:name="io.silvermind.wearcompanion.CLEAR_TIER2" />
                <action android:name="io.silvermind.wearcompanion.RELOAD_TIER2" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
