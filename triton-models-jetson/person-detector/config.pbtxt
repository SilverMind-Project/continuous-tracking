# YOLO26L person detector for Jetson Orin Nano Super.
#
# TensorRT plan generated from:
#   triton-models-jetson/person-detector/1/model_int8.onnx
#
# The QAT checkpoint is re-exported at fixed batch 1 for the 8 GB Jetson.
# The DGX model remains fixed batch 8 in the separate triton-models repository.

name: "person-detector"
platform: "tensorrt_plan"
default_model_filename: "model.plan"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [1, 3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [1, 300, 6]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
