name: "face-landmark-2d106"
platform: "tensorrt_plan"
default_model_filename: "model.plan"
max_batch_size: 0

input [
  {
    name: "data"
    data_type: TYPE_FP32
    dims: [1, 3, 192, 192]
  }
]

output [
  {
    name: "fc1"
    data_type: TYPE_FP32
    dims: [1, 212]
  }
]

instance_group [{ kind: KIND_GPU count: 1 }]
